{
  "id": "/",
  "name": "XbomaSwift",
  "short_name": "XbomaSwift",
  "description": "Find and manage rental homes across Kenya.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#0e2a45",
  "background_color": "#f8fafc",
  "prefer_related_applications": false,
  "categories": ["lifestyle", "house-and-home"],
  "icons": [
    {
      "src": "/static/myApp/images/pwa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/static/myApp/images/pwa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/static/myApp/images/pwa-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
