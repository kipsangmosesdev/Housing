DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Local development may leave DATABASE_URL blank to use db.sqlite3.
# For Neon, use a pooled connection URL for the Vercel runtime; use the direct
# (non-pooled) URL when running Django migrations.
DATABASE_URL=

# SMTP (optional locally; set these for production email delivery)
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# S3-compatible persistent storage (required in production for uploaded property media)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_ADDRESSING_STYLE=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=True
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Integrations (set only for features you enable)
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=
MPESA_ENVIRONMENT=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_AUTH_URL=
MPESA_STK_URL=
